              "description": "Source: marketing_spend; June = 5 rows = 5 channels × 1 month, so spend is deducted only once.",
              "tone": "warning"
            },
            {
              "id": "v_cp",
              "kind": "result",
              "label": "Contribution profit $9,090.55 | Contribution margin 16.83%",
              "description": "Source: profit before marketing − marketing spend; amount in USD.",
              "tone": "success"
            }
          ],
          "edges": [
